# Copy to .env and fill in.
# Required: your VulnWatch dashboard personal access token.
# Create one: https://app.vulnwatch.tech/dashboard -> API tokens
VULNWATCH_API_TOKEN=

# Optional: override the API base URL (normally left at the default).
# VULNWATCH_API_BASE=https://app.vulnwatch.tech/api

# Optional: set to 1 to enable the side-effecting submit_scan tool.
# VULNWATCH_MCP_ALLOW_SCAN=0